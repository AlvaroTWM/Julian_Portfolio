---
import { site } from '../content/site.ts';
import type { Content } from '../content/types.ts';

interface Props {
	t: Content;
}

const { t } = Astro.props;
const { hero } = t;
---

<section class="hero wrap" aria-labelledby="hero-name">
	<h1 id="hero-name">
		{site.name}
		<span class="role">{hero.role}</span>
	</h1>
	<p class="meta mono">
		<span>{hero.location}</span>
		<span aria-hidden="true">·</span>
		<span>{site.timezone}</span>
		<span aria-hidden="true">·</span>
		<span class="available">{hero.availability}</span>
	</p>

	<p class="lead">{hero.lead}</p>
	{hero.body.map((paragraph) => <p class="body">{paragraph}</p>)}

	<p class="now">
		<span class="mono muted">{t.ui.nowLabel}</span>
		{hero.now}
	</p>

	<ul class="actions inline-list">
		<li><a class="arrow-link down" href={t.cvs[0].href} download>{t.ui.downloadCv}</a></li>
		<li><a class="arrow-link" href={site.githubUrl} rel="me">GitHub</a></li>
		<li><a class="arrow-link" href={site.linkedinUrl} rel="me">LinkedIn</a></li>
		<li><a class="arrow-link" href={`mailto:${site.email}`}>{t.ui.email}</a></li>
	</ul>
</section>

<style>
	.hero {
		padding-top: clamp(3rem, 10vw, 6rem);
	}

	h1 {
		font-size: clamp(2.25rem, 6vw, 3.25rem);
		letter-spacing: -0.025em;
	}

	.role {
		display: block;
		margin-top: 0.35rem;
		font-size: clamp(1.15rem, 2.6vw, 1.4rem);
		font-weight: 400;
		letter-spacing: -0.005em;
		color: var(--muted);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.6rem;
		margin-top: 1.25rem;
		color: var(--muted);
	}

	.available::before {
		content: '';
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		margin-right: 0.45rem;
		border-radius: 50%;
		background: #2f9e5b;
		vertical-align: 0.05em;
	}

	.lead {
		margin-top: clamp(2.5rem, 7vw, 3.5rem);
		font-size: clamp(1.35rem, 3.2vw, 1.75rem);
		line-height: 1.35;
		font-weight: 500;
		letter-spacing: -0.015em;
	}

	.body {
		margin-top: 1rem;
		max-width: 40rem;
	}

	.now {
		margin-top: 1.5rem;
		padding: 0.75rem 1rem;
		border-left: 2px solid var(--accent);
		background: var(--surface);
	}

	.now .mono {
		margin-right: 0.5rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-size: 0.75rem;
	}

	.actions {
		margin-top: 2rem;
	}
</style>
