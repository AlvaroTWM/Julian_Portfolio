---
// GoodFellas Corp signature intro.
// - About 2.6 s: the original animation runs at SPEED x its authored timing.
// - Shown once per browser, never blocks: any click, key, scroll or touch skips it.
// - Not shown without JavaScript or with "reduce motion". The footer signature replays it.
import introRaw from '../assets/brand/goodfellas-intro.svg?raw';
import type { Content } from '../content/types.ts';

interface Props {
	t: Content;
}

const { t } = Astro.props;

const SPEED = 0.45; // 5.8 s authored -> ~2.6 s
const DURATION_MS = Math.round(5800 * SPEED);

const scaleTimes = (css: string) =>
	css.replace(/(\d*\.?\d+)(ms|s)\b/g, (_, value: string, unit: string) => {
		const scaled = Number(value) * SPEED;
		return `${Number(scaled.toFixed(unit === 'ms' ? 1 : 3))}${unit}`;
	});

const intro = introRaw
	.replace(/<style>([\s\S]*?)<\/style>/, (_, css: string) => `<style>${scaleTimes(css)}</style>`)
	.replace('>CREADO POR<', `>${t.ui.introMadeBy}<`)
	.replace('<svg ', `<svg class="gf-intro-art" role="img" aria-label="${t.ui.introLabel}" `);
---

<div class="gf-intro" id="gf-intro" aria-hidden="true" data-duration={DURATION_MS}>
	<Fragment set:html={intro} />
</div>

<script is:inline>
	// Inline and synchronous on purpose: it runs before the rest of the page is painted,
	// so the page never flashes and a skip works from the very first frame.
	(function () {
		var root = document.documentElement;
		var intro = document.getElementById('gf-intro');
		if (!intro) return;
		var duration = Number(intro.getAttribute('data-duration')) || 2600;
		var skipEvents = ['pointerdown', 'keydown', 'wheel', 'touchstart'];
		var timer = 0;
		var reduceMotion = function () {
			return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		};

		// Portrait screens: the text goes under the skull.
		function fitOrientation(svg) {
			var vertical = window.innerWidth < window.innerHeight;
			var text = svg.querySelector('#gf-texto');
			svg.classList.toggle('gf-v', vertical);
			svg.setAttribute('viewBox', svg.getAttribute(vertical ? 'data-vb-v' : 'data-vb-h'));
			if (!text) return;
			if (!text.hasAttribute('data-t-h')) text.setAttribute('data-t-h', text.getAttribute('transform') || '');
			var t = vertical ? text.getAttribute('data-t-v') : text.getAttribute('data-t-h');
			if (t) text.setAttribute('transform', t);
			else text.removeAttribute('transform');
		}

		function close() {
			if (!root.classList.contains('gf-intro-on')) return;
			window.clearTimeout(timer);
			skipEvents.forEach(function (type) {
				window.removeEventListener(type, close, true);
			});
			try {
				localStorage.setItem('gf-intro-seen', '1');
			} catch (e) {}
			intro.classList.add('gf-intro-out');
			window.setTimeout(function () {
				root.classList.remove('gf-intro-on');
				intro.classList.remove('gf-intro-out');
			}, 400);
		}

		function play() {
			// A fresh copy of the SVG restarts its CSS animations from zero.
			var svg = intro.querySelector('.gf-intro-art');
			if (svg) {
				var fresh = svg.cloneNode(true);
				svg.parentNode.replaceChild(fresh, svg);
				fitOrientation(fresh);
			}
			intro.classList.remove('gf-intro-out');
			root.classList.add('gf-intro-on');
			window.clearTimeout(timer);
			timer = window.setTimeout(close, duration);
			skipEvents.forEach(function (type) {
				window.addEventListener(type, close, { capture: true, passive: true });
			});
		}

		window.gfIntroReplay = function () {
			if (reduceMotion()) return;
			window.scrollTo(0, 0);
			// Wait for the click that asked for the replay to finish before listening for skips.
			window.setTimeout(play, 0);
		};

		document.addEventListener('click', function (event) {
			var target = event.target;
			if (target && target.closest && target.closest('[data-gf-replay]')) window.gfIntroReplay();
		});

		try {
			if (reduceMotion() || localStorage.getItem('gf-intro-seen')) return;
		} catch (e) {
			return;
		}
		play();
	})();
</script>

<style is:global>
	.gf-intro {
		display: none;
	}

	html.gf-intro-on .gf-intro {
		position: fixed;
		inset: 0;
		z-index: 1000;
		display: grid;
		place-items: center;
		background: #000;
		cursor: pointer;
		transition: opacity 0.4s ease;
	}

	.gf-intro.gf-intro-out {
		opacity: 0;
		pointer-events: none;
	}

	.gf-intro-art {
		width: min(80vw, 900px);
		max-height: 70vh;
		height: auto;
		overflow: visible;
	}

	.gf-intro-art.gf-v {
		width: min(80vw, 420px);
	}
</style>
