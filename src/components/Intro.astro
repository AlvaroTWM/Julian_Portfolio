---
// Pantalla de entrada: "Made for GoodFellas Corp" con el logo animado sobre negro.
// Se muestra una vez por sesión; se salta con clic, toque o cualquier tecla.
// Sin JavaScript o con "reducir movimiento" no aparece y la página se ve directo.
import logoRaw from '../assets/brand/goodfellas-corp-logo-animado.svg?raw';

const logo = logoRaw
	.replace(/<\?xml[^>]*>\s*/, '')
	.replace(' width="1000" height="1000"', ' class="gf-intro-logo" role="img" aria-label="GoodFellas Corp"');
---

<div class="gf-intro" id="gf-intro" aria-hidden="true">
	<div class="gf-intro-inner">
		<p class="gf-intro-made">Made for</p>
		<Fragment set:html={logo} />
	</div>
	<span class="gf-intro-skip">Tocá para saltar</span>
</div>

<script is:inline>
	(function () {
		try {
			var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (!reduce && !sessionStorage.getItem('gf-intro')) {
				document.documentElement.classList.add('gf-intro-on');
			}
		} catch (e) {}
	})();
</script>

<script>
	const root = document.documentElement;
	const intro = document.getElementById("gf-intro");
	const DURATION = 5900; // un ciclo completo: pitada + bocanada

	if (intro && root.classList.contains('gf-intro-on')) {
		let done = false;
		const close = () => {
			if (done) return;
			done = true;
			try {
				sessionStorage.setItem('gf-intro', '1');
			} catch {}
			intro.classList.add('gf-intro-out');
			window.setTimeout(() => {
				root.classList.remove('gf-intro-on');
				intro.remove();
			}, 800);
		};
		const timer = window.setTimeout(close, DURATION);
		const skip = () => {
			window.clearTimeout(timer);
			close();
		};
		intro.addEventListener('click', skip);
		window.addEventListener('keydown', skip, { once: true });
	} else {
		intro?.remove();
	}
</script>

<style is:global>
	.gf-intro {
		display: none;
	}

	html.gf-intro-on {
		overflow: hidden;
	}

	html.gf-intro-on .gf-intro {
		position: fixed;
		inset: 0;
		z-index: 1000;
		display: grid;
		place-items: center;
		background: #000;
		cursor: pointer;
		transition: opacity 0.8s ease;
	}

	.gf-intro.gf-intro-out {
		opacity: 0;
		pointer-events: none;
	}

	.gf-intro-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 0 16px;
	}

	.gf-intro-made {
		margin: 0 0 -1.5vmin;
		font-family: 'Inter', system-ui, sans-serif;
		font-weight: 300;
		font-size: clamp(0.75rem, 1.6vmin, 1rem);
		letter-spacing: 0.6em;
		text-transform: uppercase;
		color: rgba(244, 241, 234, 0.75);
		opacity: 0;
		animation: gf-intro-fade 1s ease 0.2s forwards;
	}

	.gf-intro-logo {
		width: min(92vw, 72vh, 560px);
		height: auto;
		opacity: 0;
		transform: scale(0.96);
		animation: gf-intro-logo-in 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
	}

	.gf-intro-skip {
		position: absolute;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 0.7rem;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.35);
		opacity: 0;
		animation: gf-intro-fade 1s ease 1.5s forwards;
	}

	@keyframes gf-intro-fade {
		to {
			opacity: 1;
		}
	}

	@keyframes gf-intro-logo-in {
		to {
			opacity: 1;
			transform: scale(1);
		}
	}
</style>
