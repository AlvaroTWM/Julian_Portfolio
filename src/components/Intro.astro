---
// GoodFellas Corp signature intro.
// - About 2.6 s: the original animation runs at SPEED x its authored timing.
// - Shown once per browser, never blocks: any click, key, scroll or touch skips it.
// - Not shown without JavaScript or with "reduce motion". The footer signature replays it.
import introRaw from '../assets/brand/goodfellas-intro.svg?raw';

const SPEED = 0.45; // 5.8 s authored -> ~2.6 s
const DURATION_MS = Math.round(5800 * SPEED);

const scaleTimes = (css: string) =>
	css.replace(/(\d*\.?\d+)(ms|s)\b/g, (_, value: string, unit: string) => {
		const scaled = Number(value) * SPEED;
		return `${Number(scaled.toFixed(unit === 'ms' ? 1 : 3))}${unit}`;
	});

const intro = introRaw
	.replace(/<style>([\s\S]*?)<\/style>/, (_, css: string) => `<style>${scaleTimes(css)}</style>`)
	.replace('>CREADO POR<', '>MADE BY<')
	.replace('<svg ', '<svg class="gf-intro-art" role="img" aria-label="Made by GoodFellas Corp" ');
---

<div class="gf-intro" id="gf-intro" aria-hidden="true" data-duration={DURATION_MS}>
	<Fragment set:html={intro} />
</div>

<script is:inline>
	(function () {
		try {
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			if (localStorage.getItem('gf-intro-seen')) return;
			document.documentElement.classList.add('gf-intro-on');
		} catch (e) {}
	})();
</script>

<script>
	const root = document.documentElement;
	const intro = document.getElementById('gf-intro');
	const duration = Number(intro?.dataset.duration ?? 2600);
	const SKIP_EVENTS = ['pointerdown', 'keydown', 'wheel', 'touchstart'] as const;

	// Portrait screens: text goes under the skull.
	const fitOrientation = (svg: SVGSVGElement | null) => {
		if (!svg) return;
		const vertical = window.innerWidth < window.innerHeight;
		const text = svg.querySelector('#gf-texto');
		svg.classList.toggle('gf-v', vertical);
		svg.setAttribute('viewBox', svg.getAttribute(vertical ? 'data-vb-v' : 'data-vb-h') ?? '');
		if (text) {
			const t = text.getAttribute('data-t-v');
			if (vertical && t) {
				text.setAttribute('data-t-h', text.getAttribute('transform') ?? '');
				text.setAttribute('transform', t);
			} else if (!vertical && text.hasAttribute('data-t-h')) {
				text.setAttribute('transform', text.getAttribute('data-t-h') ?? '');
			}
		}
	};

	let timer = 0;

	const close = () => {
		if (!intro || !root.classList.contains('gf-intro-on')) return;
		window.clearTimeout(timer);
		SKIP_EVENTS.forEach((type) => window.removeEventListener(type, close));
		try {
			localStorage.setItem('gf-intro-seen', '1');
		} catch {}
		intro.classList.add('gf-intro-out');
		window.setTimeout(() => {
			root.classList.remove('gf-intro-on');
			intro.classList.remove('gf-intro-out');
		}, 400);
	};

	const play = () => {
		if (!intro) return;
		// Re-insert the SVG so its CSS animations start from zero.
		const svg = intro.querySelector<SVGSVGElement>('.gf-intro-art');
		if (svg) {
			const fresh = svg.cloneNode(true) as SVGSVGElement;
			svg.replaceWith(fresh);
			fitOrientation(fresh);
		}
		root.classList.add('gf-intro-on');
		timer = window.setTimeout(close, duration);
		// Wait a tick so the click that started a replay doesn't close it.
		window.setTimeout(() => {
			SKIP_EVENTS.forEach((type) => window.addEventListener(type, close, { passive: true }));
		}, 50);
	};

	if (root.classList.contains('gf-intro-on')) play();

	document.querySelectorAll('[data-gf-replay]').forEach((button) => {
		button.addEventListener('click', () => {
			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			window.scrollTo({ top: 0 });
			play();
		});
	});
</script>

<style is:global>
	.gf-intro {
		display: none;
	}

	html.gf-intro-on .gf-intro {
		position: fixed;
		inset: 0;
		z-index: 1000;
		display: grid;
		place-items: center;
		background: #000;
		cursor: pointer;
		transition: opacity 0.4s ease;
	}

	.gf-intro.gf-intro-out {
		opacity: 0;
		pointer-events: none;
	}

	.gf-intro-art {
		width: min(80vw, 900px);
		max-height: 70vh;
		height: auto;
		overflow: visible;
	}

	.gf-intro-art.gf-v {
		width: min(80vw, 420px);
	}
</style>
