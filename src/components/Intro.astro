---
// Pantalla de entrada: calavera animada a la izquierda y "Creado por GoodFellas Corp" a la derecha.
// Se muestra una vez por sesión; se salta con clic, toque o cualquier tecla.
// Sin JavaScript o con "reducir movimiento" no aparece y la página se ve directo.
import calaveraRaw from '../assets/brand/goodfellas-calavera-animada.svg?raw';
import wordmarkRaw from '../assets/brand/goodfellas-wordmark.svg?raw';

const calavera = calaveraRaw.replace('<svg ', '<svg class="gf-intro-logo" aria-hidden="true" ');
const wordmark = wordmarkRaw.replace('<svg ', '<svg class="gf-intro-wordmark" role="img" aria-label="GoodFellas Corp" ');
---

<div class="gf-intro" id="gf-intro" aria-hidden="true">
	<div class="gf-intro-inner">
		<Fragment set:html={calavera} />
		<div class="gf-intro-text">
			<p class="gf-intro-made">Creado por</p>
			<Fragment set:html={wordmark} />
		</div>
	</div>
	<span class="gf-intro-skip">Tocá para saltar</span>
</div>

<script is:inline>
	(function () {
		try {
			var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (!reduce && !sessionStorage.getItem('gf-intro')) {
				document.documentElement.classList.add('gf-intro-on');
			}
		} catch (e) {}
	})();
</script>

<script>
	const root = document.documentElement;
	const intro = document.getElementById("gf-intro");
	const DURATION = 5900; // un ciclo completo: pitada + bocanada

	if (intro && root.classList.contains('gf-intro-on')) {
		let done = false;
		const close = () => {
			if (done) return;
			done = true;
			try {
				sessionStorage.setItem('gf-intro', '1');
			} catch {}
			intro.classList.add('gf-intro-out');
			window.setTimeout(() => {
				root.classList.remove('gf-intro-on');
				intro.remove();
			}, 800);
		};
		const timer = window.setTimeout(close, DURATION);
		const skip = () => {
			window.clearTimeout(timer);
			close();
		};
		intro.addEventListener('click', skip);
		window.addEventListener('keydown', skip, { once: true });
	} else {
		intro?.remove();
	}
</script>

<style is:global>
	.gf-intro {
		display: none;
	}

	html.gf-intro-on {
		overflow: hidden;
	}

	html.gf-intro-on .gf-intro {
		position: fixed;
		inset: 0;
		z-index: 1000;
		display: grid;
		place-items: center;
		background: #000;
		cursor: pointer;
		transition: opacity 0.8s ease;
	}

	.gf-intro.gf-intro-out {
		opacity: 0;
		pointer-events: none;
	}

	.gf-intro-inner {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(24px, 4vw, 64px);
		padding: 0 16px;
	}

	.gf-intro-logo {
		overflow: visible;
		width: min(42vw, 62vh, 520px);
		height: auto;
		flex: none;
		opacity: 0;
		transform: scale(0.96);
		animation: gf-intro-logo-in 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
	}

	.gf-intro-text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.gf-intro-made {
		margin: 0 0 clamp(8px, 1.5vw, 16px);
		font-family: 'Inter', system-ui, sans-serif;
		font-weight: 300;
		font-size: clamp(0.7rem, 1.1vw, 0.95rem);
		letter-spacing: 0.5em;
		text-transform: uppercase;
		color: rgba(244, 241, 234, 0.75);
		opacity: 0;
		animation: gf-intro-fade 1s ease 0.5s forwards;
	}

	.gf-intro-wordmark {
		width: min(36vw, 440px);
		height: auto;
		opacity: 0;
		animation: gf-intro-fade 1.2s ease 0.9s forwards;
	}

	@media (max-width: 720px) {
		.gf-intro-inner {
			flex-direction: column;
			gap: 20px;
		}

		.gf-intro-logo {
		overflow: visible;
			width: min(80vw, 46vh);
		}

		.gf-intro-text {
			align-items: center;
		}

		.gf-intro-wordmark {
			width: min(80vw, 360px);
		}
	}

	.gf-intro-skip {
		position: absolute;
		bottom: 24px;
		left: 50%;
		transform: translateX(-50%);
		font-family: 'Inter', system-ui, sans-serif;
		font-size: 0.7rem;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.35);
		opacity: 0;
		animation: gf-intro-fade 1s ease 1.5s forwards;
	}

	@keyframes gf-intro-fade {
		to {
			opacity: 1;
		}
	}

	@keyframes gf-intro-logo-in {
		to {
			opacity: 1;
			transform: scale(1);
		}
	}
</style>
