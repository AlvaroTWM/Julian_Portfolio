---
import { site } from '../content/site.ts';
import type { Content } from '../content/types.ts';

interface Props {
	t: Content;
}

const { t } = Astro.props;
const links = [
	{ label: t.ui.nav.work, href: '#work' },
	{ label: t.ui.nav.experience, href: '#experience' },
	{ label: t.ui.nav.contact, href: '#contact' },
];
---

<header class="site-header wrap">
	<a class="site-name" href={t.path}>{site.name}</a>
	<nav aria-label={t.ui.nav.mainLabel}>
		<ul>
			{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
			<li><a href={t.cvs[0].href} class="cv-link">{t.ui.nav.cv}</a></li>
			<li>
				<a
					href={t.ui.switchLang.href}
					hreflang={t.lang === 'en' ? 'es' : 'en'}
					lang={t.lang === 'en' ? 'es' : 'en'}
					class="lang-link"
					title={t.ui.switchLang.label}
					>{t.ui.switchLang.short}<span class="visually-hidden">, {t.ui.switchLang.label}</span></a
				>
			</li>
		</ul>
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1.5rem;
		padding-bottom: 1.5rem;
		font-size: 0.9375rem;
	}

	.site-name {
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}

	ul {
		display: flex;
		gap: clamp(0.9rem, 3vw, 1.5rem);
		padding: 0;
		margin: 0;
		list-style: none;
	}

	nav a {
		color: var(--muted);
		text-decoration: none;
	}

	nav a:hover {
		color: var(--text);
	}

	.lang-link {
		padding: 0.05rem 0.4rem;
		border: 1px solid var(--line);
		border-radius: 4px;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
	}

	.cv-link {
		color: var(--text);
		font-weight: 500;
	}

	@media (max-width: 30rem) {
		nav li:nth-child(2),
		nav li:nth-child(3) {
			display: none;
		}
	}
</style>
