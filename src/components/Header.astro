---
import { cvs, site } from '../data/site.ts';

const links = [
	{ label: 'Work', href: '#work' },
	{ label: 'Experience', href: '#experience' },
	{ label: 'Contact', href: '#contact' },
];
---

<header class="site-header wrap">
	<a class="site-name" href="/">{site.name}</a>
	<nav aria-label="Main">
		<ul>
			{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
			<li><a href={cvs[0].href} class="cv-link">CV</a></li>
		</ul>
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1.5rem;
		padding-bottom: 1.5rem;
		font-size: 0.9375rem;
	}

	.site-name {
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}

	ul {
		display: flex;
		gap: clamp(0.9rem, 3vw, 1.5rem);
		padding: 0;
		margin: 0;
		list-style: none;
	}

	nav a {
		color: var(--muted);
		text-decoration: none;
	}

	nav a:hover {
		color: var(--text);
	}

	.cv-link {
		color: var(--text);
		font-weight: 500;
	}

	@media (max-width: 30rem) {
		nav li:not(:last-child):not(:first-child) {
			display: none;
		}
	}
</style>
