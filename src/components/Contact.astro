---
import { site } from '../content/site.ts';
import type { Content } from '../content/types.ts';

interface Props {
	t: Content;
}

const { t } = Astro.props;
---

<section id="contact" class="section wrap" aria-labelledby="contact-title">
	<h2 id="contact-title" class="section-title"><span>{t.ui.sections.contact}</span></h2>
	<p class="pitch">{t.contact.pitch}</p>
	<p class="email"><a href={`mailto:${site.email}`}>{site.email}</a></p>
	<ul class="channels">
		<li>
			<span class="mono muted">GitHub</span>
			<a class="arrow-link" href={site.githubUrl} rel="me">{site.githubHandle}</a>
		</li>
		<li>
			<span class="mono muted">LinkedIn</span>
			<a class="arrow-link" href={site.linkedinUrl} rel="me">{site.linkedinHandle}</a>
		</li>
		{
			t.cvs.map((cv) => (
				<li>
					<span class="mono muted">{t.contact.cvLabel(cv.label)}</span>
					<a class="arrow-link down" href={cv.href} download>
						PDF
					</a>
				</li>
			))
		}
	</ul>
</section>


<style>
	.pitch {
		max-width: 36rem;
		font-size: 1.125rem;
	}

	.email {
		margin-top: 1.25rem;
		font-size: clamp(1.25rem, 4vw, 1.75rem);
		font-weight: 500;
		letter-spacing: -0.015em;
		overflow-wrap: anywhere;
	}

	.channels {
		display: grid;
		gap: 0.5rem;
		margin-top: 2rem;
		padding: 0;
		list-style: none;
	}

	.channels li {
		display: grid;
		grid-template-columns: 10.5rem 1fr;
		gap: 1rem;
		align-items: baseline;
	}

	.channels .mono {
		font-size: 0.8125rem;
	}

	@media (max-width: 30rem) {
		.channels li {
			grid-template-columns: 1fr;
			gap: 0;
		}
	}
</style>
