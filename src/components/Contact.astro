---
import { contact, site } from '../data/site.ts';
---

<section class="section section--contact" id="contacto" aria-labelledby="contact-heading">
	<header class="section-header">
		<h2 class="section-title" id="contact-heading">{contact.title}</h2>
		<p class="section-subtitle section-subtitle--wide">{contact.intro}</p>
		<p class="contact-availability">{contact.availability}</p>
	</header>

	<div class="contact-links">
		<a class="contact-link" href={site.githubUrl} target="_blank" rel="noopener noreferrer">
			<span class="contact-link__label">GitHub</span>
			<span class="contact-link__hint">Repositorios y código</span>
		</a>
		<a class="contact-link" href={site.linkedinUrl} target="_blank" rel="noopener noreferrer">
			<span class="contact-link__label">LinkedIn</span>
			<span class="contact-link__hint">Perfil profesional</span>
		</a>
		<a class="contact-link" href={site.email}>
			<span class="contact-link__label">Correo</span>
			<span class="contact-link__hint">{site.emailDisplay}</span>
		</a>
	</div>

	<p class="contact-footer">
		<a class="contact-footer__link" href="#habilidades">Ver habilidades</a>
		<span aria-hidden="true">·</span>
		<a class="contact-footer__link" href={site.cvUrl} download>
			Descargar CV
		</a>
	</p>
</section>
